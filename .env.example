# Copy to .env next to docker-compose.yml
LANMON_PORT=8765
# Optional: detected automatically otherwise
# LANMON_SUBNET=192.168.1.0/24
# LANMON_INTERFACE=eth0
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
LANMON_SECRET_KEY=
TZ=Europe/Bucharest
# Time zone for WOL schedules and uptime days (default Europe/Bucharest)
# LANMON_TZ=Europe/Bucharest
